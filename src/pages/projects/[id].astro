---
import Layout from "@/layouts/Layout.astro";
import { projects, getProject } from "@/data/projects";
import { ProjectAboutHero } from "@/components/project-about-hero";
import { SiteFooter } from "@/components/site-footer";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { id: project.id },
  }));
}

const { id } = Astro.params;
const project = getProject(id!);

if (!project) {
  return Astro.redirect("/");
}
---

<Layout title={`${project.name} — Backspace®`} description={project.lead}>
  <main class="bg-background text-foreground">
    <div class="plate">
      <div class="plate-meta">
        <div>
          <span class="mono-lbl block opacity-55">Subject</span>
          <b class="mt-1 block text-[13px] uppercase tracking-wide">{project.name}</b>
        </div>
        <div>
          <span class="mono-lbl block opacity-55">Role</span>
          <b class="mt-1 block text-[13px] uppercase tracking-wide">{project.role}</b>
        </div>
        <div>
          <span class="mono-lbl block opacity-55">Status</span>
          <span
            class:list={[
              "plate-badge mono-lbl mt-1 inline-flex",
              project.live && "live",
            ]}
          >
            {project.status}
          </span>
        </div>
      </div>

      <ProjectAboutHero client:load project={project} />

      <section class="px-6 py-9 md:px-8">
        <h2 class="mono-lbl mb-4 opacity-55">Roadmap</h2>
        <p class="max-w-[560px] italic opacity-75">
          Milestones and timeline will go here — you'll define the roadmap for {project.name} next.
        </p>
      </section>

      <section class="px-6 py-9 md:px-8">
        <h2 class="mono-lbl mb-4 opacity-55">Work in progress</h2>
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
          <div class="mono-lbl flex aspect-[16/10] items-center justify-center border border-border opacity-55 sm:col-span-2 sm:aspect-[21/9]">
            preview
          </div>
        </div>
        <a href="/" class="mono-lbl mt-8 inline-block transition-colors hover:opacity-60">
          ← Back to studio
        </a>
      </section>
    </div>
    <SiteFooter client:visible />
  </main>
</Layout>
