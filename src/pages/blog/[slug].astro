---
import Layout from "@/layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import { SiteFooter } from "@/components/site-footer";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

function formatDate(date: Date) {
  return date.toLocaleDateString("en-GB", { day: "2-digit", month: "short", year: "numeric" }).toUpperCase();
}
---

<Layout title={`${post.data.title} — Backspace®`} description={post.data.description}>
  <main class="bg-background text-foreground">
    <article class="plate">
      <div class="plate-row">
        <a href="/blog" class="mono-lbl transition-colors hover:opacity-60">← Back to blog</a>
        <time class="mono-lbl opacity-55" datetime={post.data.pubDate.toISOString()}>
          {formatDate(post.data.pubDate)}
        </time>
      </div>

      <header class="px-6 py-9 md:px-8">
        <h1 class="text-[28px] font-black uppercase leading-[1.05] tracking-[-0.02em] md:text-[42px]">
          {post.data.title}
        </h1>
        <p class="mt-4 max-w-[560px] text-[14px] leading-relaxed opacity-75">{post.data.description}</p>
      </header>

      <div class="prose-blog px-6 py-9 md:px-8">
        <Content />
      </div>
    </article>
    <SiteFooter client:visible />
  </main>
</Layout>
