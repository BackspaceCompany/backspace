---
import Layout from "@/layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import { SiteFooter } from "@/components/site-footer";
import BlogToc from "@/components/BlogToc.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

function formatDate(date: Date) {
  return date.toLocaleDateString("en-US", {
    month: "long",
    day: "numeric",
    year: "numeric",
  });
}
---

<Layout title={`${post.data.title} — Backspace®`} description={post.data.description}>
  <main class="bg-background text-foreground">
    <article class="mx-auto max-w-[960px] px-6 pb-14 pt-16 md:pt-[64px]">
      <a href="/blog" class="text-sm text-[#8a8a8a] transition-colors hover:text-[#111]">
        ← Back to blog
      </a>

      <div class="mt-8 grid grid-cols-1 gap-10 lg:grid-cols-[148px_minmax(0,1fr)] lg:gap-16 xl:gap-20">
        <aside class="lg:sticky lg:top-[calc(var(--nav-h)+32px)] lg:self-start">
          <BlogToc headings={headings} />
        </aside>

        <div>
          <header class="mb-10">
            <time class="text-xs text-[#8a8a8a]" datetime={post.data.pubDate.toISOString()}>
              {formatDate(post.data.pubDate)}
            </time>
            <h1 class="mt-2 text-[26px] font-medium leading-tight tracking-[-0.3px] md:text-[30px]">
              {post.data.title}
            </h1>
            <p class="mt-3 max-w-[560px] text-[15px] leading-relaxed text-[#8a8a8a]">
              {post.data.description}
            </p>
          </header>

          <div class="prose-blog">
            <Content />
          </div>
        </div>
      </div>
    </article>
    <SiteFooter client:visible />
  </main>
</Layout>
