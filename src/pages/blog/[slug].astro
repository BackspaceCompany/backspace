---
import Layout from "@/layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import { SiteFooter } from "@/components/site-footer";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

function formatDate(date: Date) {
  return date.toLocaleDateString("en-US", {
    month: "long",
    day: "numeric",
    year: "numeric",
  });
}
---

<Layout title={`${post.data.title} — Backspace®`} description={post.data.description}>
  <main class="bg-background text-foreground">
    <article class="mx-auto max-w-[760px] px-6 pb-14 pt-16 md:pt-[64px]">
      <a href="/blog" class="text-sm text-[#8a8a8a] transition-colors hover:text-[#111]">
        ← Back to blog
      </a>

      <header class="mt-6 border-b border-[#e6e6e6] pb-8">
        <time class="text-xs text-[#8a8a8a]" datetime={post.data.pubDate.toISOString()}>
          {formatDate(post.data.pubDate)}
        </time>
        <h1 class="mt-3 text-[28px] font-medium leading-tight tracking-[-0.3px] md:text-[34px]">
          {post.data.title}
        </h1>
        <p class="mt-3 max-w-[620px] text-[#8a8a8a]">{post.data.description}</p>
      </header>

      <div class="prose-blog py-8">
        <Content />
      </div>
    </article>
    <SiteFooter client:visible />
  </main>
</Layout>
