---
import Layout from "@/layouts/Layout.astro";
import { getCollection } from "astro:content";
import { SiteFooter } from "@/components/site-footer";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

function formatDate(date: Date) {
  return date.toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
  });
}
---

<Layout title="Blog — Backspace®" description="Notes on AI, commerce, and building venture products.">
  <main class="bg-background text-foreground">
    <div class="mx-auto max-w-[760px] px-6 pb-14 pt-16 md:pt-[64px]">
      <h1 class="text-[13px] font-semibold uppercase tracking-[0.06em] text-[#8a8a8a]">Blog</h1>
      <p class="mt-3 mb-10 max-w-[560px] text-[#8a8a8a]">
        Notes on AI systems, informal commerce, and building products at Backspace.
      </p>

      <div class="divide-y divide-[#e6e6e6] border-y border-[#e6e6e6]">
        {
          posts.map((post) => (
            <a href={`/blog/${post.id}`} class="group block py-5">
              <time class="text-xs text-[#8a8a8a]" datetime={post.data.pubDate.toISOString()}>
                {formatDate(post.data.pubDate)}
              </time>
              <h2 class="mt-1 text-[15px] font-semibold group-hover:underline">{post.data.title}</h2>
              <p class="mt-1 text-sm text-[#8a8a8a]">{post.data.description}</p>
            </a>
          ))
        }
      </div>
    </div>
    <SiteFooter client:visible />
  </main>
</Layout>
