---
import Layout from "@/layouts/Layout.astro";
import { getCollection } from "astro:content";
import { SiteFooter } from "@/components/site-footer";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

function formatDate(date: Date) {
  return date.toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
  });
}
---

<Layout title="Blog — Backspace®" description="Notes on AI, commerce, and building venture products.">
  <main class="bg-background text-foreground">
    <div class="mx-auto max-w-[760px] px-6 pb-14 pt-16 md:pt-[64px]">
      <h1 class="mb-2 text-[22px] font-medium tracking-[-0.2px]">Blog</h1>
      <p class="mb-10 max-w-[560px] text-muted-foreground">
        Notes on AI systems, informal commerce, and building products at Backspace.
      </p>

      <div class="divide-y divide-border border-y border-border">
        {
          posts.map((post) => (
            <a
              href={`/blog/${post.id}`}
              class="group block py-6 transition-colors hover:bg-muted -mx-3 px-3 rounded-lg"
            >
              <time class="text-xs text-muted-foreground" datetime={post.data.pubDate.toISOString()}>
                {formatDate(post.data.pubDate)}
              </time>
              <h2 class="mt-1 text-lg font-semibold group-hover:underline">{post.data.title}</h2>
              <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{post.data.description}</p>
              <span class="mt-3 inline-block text-sm font-medium text-foreground">Read article →</span>
            </a>
          ))
        }
      </div>

    </div>
    <SiteFooter client:visible />
  </main>
</Layout>
