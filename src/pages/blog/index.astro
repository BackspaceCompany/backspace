---
import Layout from "@/layouts/Layout.astro";
import { getCollection } from "astro:content";
import { SiteFooter } from "@/components/site-footer";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

function formatDate(date: Date) {
  return date.toLocaleDateString("en-GB", { day: "2-digit", month: "short", year: "numeric" }).toUpperCase();
}
---

<Layout title="Blog — Backspace®" description="Notes on AI, commerce, and building venture products.">
  <main class="bg-background text-foreground">
    <div class="plate">
      <div class="plate-meta">
        <div>
          <span class="mono-lbl block opacity-55">Subject</span>
          <b class="mt-1 block text-[13px] uppercase tracking-wide">Editorial / Notes</b>
        </div>
        <div>
          <span class="mono-lbl block opacity-55">Index</span>
          <b class="mt-1 block text-[13px] uppercase tracking-wide">Entries / 0{posts.length}</b>
        </div>
      </div>

      <div class="plate-hero">
        <h1 class="plate-giant">Blog</h1>
        <p class="mt-5 max-w-[520px] text-[14px] leading-relaxed opacity-75">
          Notes on AI systems, informal commerce, and building products at Backspace.
        </p>
      </div>

      {
        posts.map((post) => (
          <a href={`/blog/${post.id}`} class="plate-list-row plate-list-row--simple">
            <time class="mono-lbl plate-idx" datetime={post.data.pubDate.toISOString()}>
              {formatDate(post.data.pubDate)}
            </time>
            <span>
              <span class="plate-name block">{post.data.title}</span>
              <span class="plate-line mt-1 block">{post.data.description}</span>
            </span>
            <span class="plate-arrow">↗</span>
          </a>
        ))
      }
    </div>
    <SiteFooter client:visible />
  </main>
</Layout>
